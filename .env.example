# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only: never prefix with NEXT_PUBLIC_
ANTHROPIC_API_KEY=
# Server-only, scripts only (db:seed, sightings, summaries). Never NEXT_PUBLIC_, never in Vercel's browser env.
SUPABASE_SERVICE_ROLE_KEY=
# Map pictures. A free key from carto.com/basemaps (an email address, no card). It is visible in the page by design:
# restrict it by domain in CARTO's dashboard. CARTO needs a SEPARATE key for localhost:
#   - here in .env.local: a key restricted to localhost (and 127.0.0.1)
#   - in Vercel's environment variables: a key restricted to the live domain only
# With no key the map uses OpenStreetMap's own tiles. (Vercel preview URLs have other domains, so they use that fallback.)
NEXT_PUBLIC_CARTO_KEY=
# Which CARTO style (default voyager): light_all, light_nolabels, voyager, voyager_nolabels, dark_all, dark_nolabels
NEXT_PUBLIC_CARTO_STYLE=
# Switch CARTO off in a hurry (then redeploy): osm
NEXT_PUBLIC_MAP_PROVIDER=
